# POSTGRES_PASSWORD dipakai docker-compose untuk container dcelup-db, dan
# harus SAMA PERSIS dengan password di dalam DATABASE_URL di bawah.
POSTGRES_PASSWORD="ganti-dengan-password-acak"
DATABASE_URL="postgresql://dcelup:ganti-dengan-password-acak@dcelup-db:5432/dcelup_chicken"
SESSION_SECRET="ganti-dengan-random-minimal-32-karakter"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
TZ="Asia/Jakarta"
NEXT_PUBLIC_APP_URL="https://dcelup.fscomp.id"
APP_PORT="3011"
